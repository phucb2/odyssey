#!/usr/bin/env bash
# kva — Vast.ai exec CLI (colab exec analogue).
# Usage:
#   kva new [--spot] [--on-demand]
#   kva resume [--bid-price USD]
#   kva use-context INSTANCE_ID
#   kva sessions
#   kva exec -f script.py
#   kva upload LOCAL [REMOTE]
#   kva download REMOTE [LOCAL]
#   kva ssh [--port 8080]
#   kva stop [--yes]
set -euo pipefail

SCRIPT_DIR=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)
REPO_ROOT=$(cd "$SCRIPT_DIR/.." && pwd)
REMOTE_DIR=${KVA_REMOTE_DIR:-/workspace/odyssey}
PYTHON_BIN=${KVA_PYTHON:-python3}
SSH_IDENTITY=${KVA_SSH_IDENTITY:-$HOME/.ssh/id_ed25519}
# KVA_VERBOSE=1 (or KVA_LOG=all) prints ssh/rsync details and remote MOTD.
KVA_VERBOSE=${KVA_VERBOSE:-0}
KVA_LOG=${KVA_LOG:-}

usage() {
  cat <<'EOF'
kva — Vast.ai analogue of `colab exec -s ... -f ...`

Usage:
  kva new [--spot|--on-demand] [--bid-pct 10] [--size small|medium|large] [--gpu RTX_3060] [--max-dph 0.1] [--disk 20] [--yes]
  kva resume [-s INSTANCE_ID] [--bid-pct 20] [--bid-price USD] [--yes]
  kva use-context INSTANCE_ID
  kva current-context
  kva sessions
  kva exec [-s INSTANCE_ID] -f SCRIPT.py [--setup] [--detach] [--no-sync] [-- args...]
  kva upload [-s INSTANCE_ID] LOCAL [REMOTE]
  kva download [-s INSTANCE_ID] REMOTE [LOCAL]
  kva ssh [-s INSTANCE_ID] [--port 8080]
  kva stop [-s INSTANCE_ID] [--yes]

kva new:
  --spot             interruptible bid (spot) instance (default)
  --on-demand        dedicated on-demand instance
  --bid-pct PCT      bid this percent above min_bid (default: 10; 0 = exact min)
  --bid-price USD    exact spot bid $/hour (overrides --bid-pct)
  --size SIZE        GPU tier: small (default, RTX_3060), medium (20GB+), large (40GB+)
  --gpu NAME         exact GPU name (overrides --size VRAM floor)
  --max-dph USD      max GPU $/hour (default: small 0.1, medium 0.5, large 2.5)
  --disk GB          disk size (default: 20)
  --max-disk-day USD max disk $/day (default: 2 for 20GB; 0 disables)
  --label NAME       instance label (default: odyssey)
  --yes, -y          take the first offer (required if stdin is not a TTY)
  --dry-run          print the search query and exit

  Offers are shown one at a time (cheapest first):
    y  rent this offer
    n  skip to the next offer (default)
    q  quit


kva resume:
  -s, --session ID   Vast.ai instance ID (overrides current-context / \$VAST_INSTANCE_ID)
  --bid-pct PCT      raise bid by this percent (default: 20)
  --bid-price USD    exact bid $/hour (default: current + --bid-pct, at least +\$0.01)
  --yes, -y          skip the bid prompt (required if stdin is not a TTY)
  --dry-run          print the new bid and start command, then exit

  Raise the spot bid and start a stopped instance (after being outbid).
  Already-running instances are left alone unless --bid-price is set.

kva sessions:
  list all Vast.ai instances (id, status, gpu, price). * is current-context.

kva exec:
  -s, --session ID   Vast.ai instance ID (overrides current-context / $VAST_INSTANCE_ID)
  -f, --file PATH    Local script: cwd-relative, repo-relative, or absolute
  --setup            pip install -e . on the host after sync
  --detach           nohup the job; print log paths and exit
  --no-sync          skip repo rsync (source already on the host)
  -h, --help         show this help

  Paths inside the Odyssey repo are run after the usual repo rsync.
  Paths outside it are uploaded to /workspace/kva-exec/ and run from there.

kva upload / download:
  -s, --session ID   Vast.ai instance ID (overrides current-context / $VAST_INSTANCE_ID)
  LOCAL              local file or directory
  REMOTE             remote path (default upload dest: /workspace/)
  --dry-run          print the rsync command and exit
  -h, --help         show this help

  rsync -avz --progress over SSH (not vastai copy). exec skips datasets/.
  Relative REMOTE is under /workspace. Never / or /root.

  kva upload ./datasets/coco128/raw/coco128.zip
  kva download /workspace/coco128.zip ./

kva ssh:
  -s, --session ID   Vast.ai instance ID (overrides current-context / $VAST_INSTANCE_ID)
  --port N           local and remote port for -L (default: 8080)
  -L SPEC            full forward spec (overrides --port)
  --dry-run          print the ssh command and exit
  -h, --help         show this help

  Interactive shell with -L 8080:localhost:8080 (http://127.0.0.1:8080).
  Human-only; agents should not run this (needs a TTY). Extra args after --.
  Unknown TERM values (Ghostty, Kitty, ...) are sent as xterm-256color.

  kva ssh
  kva ssh --port 8888
  kva ssh -s ID

kva use-context:
  INSTANCE_ID        set default instance (like kubectl config use-context)
  --unset            clear current-context

  kva use-context ID
  kva current-context

kva stop:
  -s, --session ID   Vast.ai instance ID (overrides current-context / $VAST_INSTANCE_ID)
  --yes, -y          skip the destroy prompt (required if stdin is not a TTY)

  Destroys the instance (GPU + disk billing stop). vastai stop only pauses GPU.

SSH always uses -i ~/.ssh/id_ed25519 (override with \$KVA_SSH_IDENTITY).
Direct public_ip:direct_port_end is preferred over the proxy ssh-url.

Env:
  KVA_VERBOSE=1    show ssh/rsync lines and remote MOTD (also KVA_LOG=all)
  KVA_CONFIG       context file (default ~/.config/kva/config)
  VAST_INSTANCE_ID override current-context (still loses to -s)

Logs:
  local  runs/kva/<timestamp>_<stem>.log
  remote /workspace/odyssey/runs/kva/<timestamp>_<stem>.log
EOF
}

kva_verbose() {
  case "${KVA_VERBOSE}" in
    1|true|TRUE|yes|YES|all) return 0 ;;
  esac
  case "${KVA_LOG}" in
    all|verbose|debug) return 0 ;;
  esac
  return 1
}

kva_log() {
  kva_verbose || return 0
  printf 'kva: %s\n' "$*"
}

die() {
  printf 'kva: %s\n' "$*" >&2
  exit 1
}

require_cmd() {
  command -v "$1" >/dev/null 2>&1 || die "missing command: $1"
}

context_file() {
  if [[ -n "${KVA_CONFIG:-}" ]]; then
    printf '%s' "$KVA_CONFIG"
  else
    printf '%s' "${XDG_CONFIG_HOME:-$HOME/.config}/kva/config"
  fi
}

read_context() {
  local f line
  f=$(context_file)
  [[ -f "$f" ]] || return 0
  line=$(grep -E '^current-context=' "$f" 2>/dev/null | tail -n 1 || true)
  line=${line#current-context=}
  line=${line%$'\r'}
  printf '%s' "$line"
}

write_context() {
  local id=$1 f dir
  f=$(context_file)
  dir=$(dirname "$f")
  mkdir -p "$dir"
  printf 'current-context=%s\n' "$id" >"$f"
}

clear_context() {
  local f
  f=$(context_file)
  [[ -f "$f" ]] || return 0
  rm -f "$f"
}

require_instance() {
  if [[ -z "${INSTANCE_ID:-}" ]]; then
    INSTANCE_ID=$(read_context)
  fi
  [[ -n "$INSTANCE_ID" ]] || die "missing -s INSTANCE_ID (no current context; run kva use-context ID)"
}

require_identity() {
  [[ -n "$SSH_IDENTITY" && -f "$SSH_IDENTITY" ]] \
    || die "missing ssh key: ${SSH_IDENTITY:-unset} (expected ~/.ssh/id_ed25519)"
}

# SSH sends local TERM. Ghostty/Kitty/etc. are missing from Vast images, so
# remote tmux/ncurses abort with "missing or unsuitable terminal: xterm-ghostty".
ssh_term() {
  case ${TERM:-} in
    xterm|xterm-256color|xterm-color|screen|screen-256color|tmux|tmux-256color|linux|vt100|dumb)
      printf '%s' "$TERM"
      ;;
    *)
      printf 'xterm-256color'
      ;;
  esac
}

ssh_opts() {
  require_identity
  SSH_OPTS=(
    -o BatchMode=yes
    -o StrictHostKeyChecking=accept-new
    -o IdentitiesOnly=yes
    -i "$SSH_IDENTITY"
    -p "$SSH_PORT"
  )
  if ! kva_verbose; then
    SSH_OPTS+=(-q)
  fi
}

rsync_ssh() {
  require_identity
  local cmd quiet=${1:-}
  cmd=$(printf 'ssh -o BatchMode=yes -o StrictHostKeyChecking=accept-new -o IdentitiesOnly=yes -i %q -p %q' \
    "$SSH_IDENTITY" "$SSH_PORT")
  if [[ "$quiet" != "loud" ]] && ! kva_verbose; then
    cmd+=' -q'
  fi
  printf '%s' "$cmd"
}

parse_ssh_url() {
  local raw line direct
  require_cmd vastai
  require_identity
  raw=$(vastai show instance "$INSTANCE_ID" --raw --full --no-color) \
    || die "vastai show instance failed for $INSTANCE_ID"
  direct=$(printf '%s\n' "$raw" | python3 -c '
import json, sys
data = json.load(sys.stdin)
inst = data.get("instances", data)
if isinstance(inst, list):
    inst = inst[0] if inst else {}
ip = inst.get("public_ipaddr") or ""
port = inst.get("direct_port_end")
if ip and port not in (None, "", -1, "-1", 0, "0"):
    print(f"root@{ip}:{port}")
')
  if [[ -n "$direct" ]]; then
    SSH_PORT=${direct##*:}
    SSH_USERHOST=${direct%:*}
  else
    raw=$(vastai ssh-url "$INSTANCE_ID") || die "vastai ssh-url failed for instance $INSTANCE_ID"
    line=$(printf '%s\n' "$raw" | grep -oE 'ssh://[^[:space:]]+' | tail -n 1 || true)
    [[ -n "$line" ]] || die "could not parse ssh:// URL from: vastai ssh-url $INSTANCE_ID"
    line=${line#ssh://}
    SSH_PORT=${line##*:}
    SSH_USERHOST=${line%:*}
  fi
  [[ -n "$SSH_USERHOST" && -n "$SSH_PORT" && "$SSH_PORT" != "$SSH_USERHOST" ]] \
    || die "could not parse host:port for instance $INSTANCE_ID"
  ssh_opts
}

remote_ssh() {
  ssh "${SSH_OPTS[@]}" "$SSH_USERHOST" "$@"
}

quote_remote() {
  printf '%q' "$1"
}

resolve_remote_path() {
  local p=${1:-}
  if [[ -z "$p" ]]; then
    RESOLVED_REMOTE=/workspace/
    return
  fi
  if [[ "$p" != /* ]]; then
    p="/workspace/${p#./}"
  fi
  local norm=${p%/}
  case "$norm" in
    /|/root) die "refusing remote path $p (use /workspace/...)" ;;
  esac
  if [[ "$norm" == /root/* ]]; then
    die "refusing remote path $p (use /workspace/...)"
  fi
  RESOLVED_REMOTE=$p
}

remote_parent_dir() {
  local p=$1
  if [[ "$p" == */ ]]; then
    printf '%s' "$p"
  else
    printf '%s' "$(dirname "$p")"
  fi
}

run_rsync_transfer() {
  local src=$1 dst=$2 dry=$3
  local e
  e=$(rsync_ssh loud)
  printf 'kva: rsync -avz --progress -e "%s" %q %q\n' "$e" "$src" "$dst"
  if [[ "$dry" -eq 1 ]]; then
    return 0
  fi
  require_cmd rsync
  rsync -avz --progress -e "$e" "$src" "$dst"
}

parse_transfer_args() {
  INSTANCE_ID=${VAST_INSTANCE_ID:-}
  TRANSFER_SRC=""
  TRANSFER_DST=""
  TRANSFER_DRY=0
  local -a pos=()
  while [[ $# -gt 0 ]]; do
    case $1 in
      -s|--session)
        [[ $# -ge 2 ]] || die "-s requires an instance id"
        INSTANCE_ID=$2
        shift 2
        ;;
      --dry-run) TRANSFER_DRY=1; shift ;;
      -h|--help) usage; exit 0 ;;
      --) shift; pos+=("$@"); break ;;
      -*) die "unknown option: $1 (see kva ${TRANSFER_CMD} --help)" ;;
      *) pos+=("$1"); shift ;;
    esac
  done
  TRANSFER_SRC=""
  TRANSFER_DST=""
  if [[ ${#pos[@]} -ge 1 ]]; then
    TRANSFER_SRC=${pos[0]}
  fi
  if [[ ${#pos[@]} -ge 2 ]]; then
    TRANSFER_DST=${pos[1]}
  fi
  [[ ${#pos[@]} -le 2 ]] || die "too many arguments (see kva ${TRANSFER_CMD} --help)"
  require_instance
  [[ -n "$TRANSFER_SRC" ]] || die "missing ${TRANSFER_SRC_LABEL}"
}

kva_upload() {
  TRANSFER_CMD=upload
  TRANSFER_SRC_LABEL="LOCAL path"
  parse_transfer_args "$@"
  [[ -e "$TRANSFER_SRC" ]] || die "local path not found: $TRANSFER_SRC"
  resolve_remote_path "$TRANSFER_DST"
  parse_ssh_url
  local remote_spec dest_dir
  remote_spec="${SSH_USERHOST}:${RESOLVED_REMOTE}"
  dest_dir=$(remote_parent_dir "$RESOLVED_REMOTE")
  if [[ "$TRANSFER_DRY" -eq 0 ]]; then
    remote_ssh "mkdir -p $(quote_remote "$dest_dir")"
  fi
  run_rsync_transfer "$TRANSFER_SRC" "$remote_spec" "$TRANSFER_DRY"
}

kva_download() {
  TRANSFER_CMD=download
  TRANSFER_SRC_LABEL="REMOTE path"
  parse_transfer_args "$@"
  resolve_remote_path "$TRANSFER_SRC"
  local dest=${TRANSFER_DST:-./}
  parse_ssh_url
  local remote_spec
  remote_spec="${SSH_USERHOST}:${RESOLVED_REMOTE}"
  if [[ "$TRANSFER_DRY" -eq 0 ]]; then
    if [[ "$dest" == */ || "$dest" == . || "$dest" == ./ || -d "$dest" ]]; then
      mkdir -p "$dest"
    else
      mkdir -p "$(dirname "$dest")"
    fi
  fi
  run_rsync_transfer "$remote_spec" "$dest" "$TRANSFER_DRY"
}

resolve_script() {
  local f=$1 abs
  if [[ "$f" == /* ]]; then
    abs=$f
  elif [[ -f "$f" ]]; then
    abs=$f
  else
    abs="$REPO_ROOT/$f"
  fi
  [[ -f "$abs" ]] || die "script not found: $f"
  abs=$(cd "$(dirname "$abs")" && pwd)/$(basename "$abs")
  LOCAL_SCRIPT=$abs
  case "$abs" in
    "$REPO_ROOT"/*)
      REL_SCRIPT=${abs#"$REPO_ROOT"/}
      EXT_SCRIPT=0
      ;;
    *)
      REL_SCRIPT="/workspace/kva-exec/$(basename "$abs")"
      EXT_SCRIPT=1
      ;;
  esac
}

upload_script() {
  local dest_dir dest
  dest_dir=$(dirname "$REL_SCRIPT")
  dest=${SSH_USERHOST}:${REL_SCRIPT}
  kva_log "uploading $LOCAL_SCRIPT -> $dest"
  remote_ssh "mkdir -p $(quote_remote "$dest_dir")"
  require_cmd rsync
  rsync -az -e "$(rsync_ssh)" "$LOCAL_SCRIPT" "$dest"
}

sync_repo() {
  require_cmd rsync
  remote_ssh "mkdir -p $(quote_remote "$REMOTE_DIR")"
  rsync -az \
    -e "$(rsync_ssh)" \
    --exclude '.venv/' \
    --exclude '.git/' \
    --exclude 'datasets/' \
    --exclude 'checkpoints/' \
    --exclude 'runs/' \
    --exclude '__pycache__/' \
    --exclude '*.egg-info/' \
    --exclude '.pytest_cache/' \
    --exclude '.mypy_cache/' \
    --exclude '.ruff_cache/' \
    --exclude 'dist/' \
    --exclude 'build/' \
    --exclude 'notebooks/*_output.ipynb' \
    "$REPO_ROOT/" "${SSH_USERHOST}:${REMOTE_DIR}/"
}

run_setup() {
  local qdir
  qdir=$(quote_remote "$REMOTE_DIR")
  remote_ssh "set -euo pipefail; cd $qdir; $PYTHON_BIN -m pip install -e ."
}

log_header() {
  local cmd_line="$PYTHON_BIN -u $REL_SCRIPT"
  if ((${#EXTRA_ARGS[@]})); then
    cmd_line+=" ${EXTRA_ARGS[*]}"
  fi
  cat <<EOF
=== kva exec ===
instance: $INSTANCE_ID
host: $SSH_USERHOST
port: $SSH_PORT
identity: $SSH_IDENTITY
script: $REL_SCRIPT
started: $(date +%Y-%m-%dT%H:%M:%S%z)
command: $cmd_line
detach: $DETACH
================
EOF
}

remote_python_cmd() {
  local qscript extra=() arg
  qscript=$(quote_remote "$REL_SCRIPT")
  for arg in "${EXTRA_ARGS[@]+"${EXTRA_ARGS[@]}"}"; do
    extra+=("$(quote_remote "$arg")")
  done
  printf '%s -u %s %s' "$PYTHON_BIN" "$qscript" "${extra[*]-}"
}

storage_cost_cap() {
  local day=$1 disk=$2
  python3 -c "d=float('$day'); print('{:.4f}'.format(d * 30.0 / float('$disk')) if d > 0 else '')"
}

build_offer_query() {
  local gpu=$1 max_dph=$2 inet_down=$3 min_ram=$4 disk=$5 max_storage=$6
  local query="num_gpus=1 verified=true direct_port_count>=1 rentable=true dph<${max_dph} inet_down>=${inet_down} disk_space>=${disk}"
  if [[ -n "$max_storage" ]]; then
    query="${query} storage_cost<${max_storage}"
  fi
  if [[ -n "$gpu" ]]; then
    query="gpu_name=${gpu} ${query}"
  elif [[ -n "$min_ram" ]]; then
    query="gpu_ram>=${min_ram} ${query}"
  fi
  printf '%s' "$query"
}

search_offers() {
  local gpu=$1 max_dph=$2 inet_down=$3 min_ram=$4 disk=$5 max_storage=$6 offer_type=${7:-bid}
  local query raw
  query=$(build_offer_query "$gpu" "$max_dph" "$inet_down" "$min_ram" "$disk" "$max_storage")
  printf 'kva: searching %s --storage %s --type %s\n' "$query" "$disk" "$offer_type" >&2
  raw=$(vastai search offers "$query" -o 'dlperf_usd-' --storage "$disk" --type "$offer_type" --limit 12 --raw --full --no-color) \
    || die "vastai search offers failed"
  printf '%s\n' "$raw" | python3 -c '
import json, sys
data = json.load(sys.stdin)
offers = data if isinstance(data, list) else data.get("offers") or data.get("results") or []
if not offers:
    sys.exit(2)
offer_type = sys.argv[1] if len(sys.argv) > 1 else "bid"
for o in offers[:12]:
    dph = float(o.get("dph_total") or o.get("dph_base") or 0)
    if offer_type == "bid":
        dph = float(o.get("min_bid") or dph)
    loc = o.get("geolocation") or ""
    rel = o.get("reliability2") or o.get("reliability") or 0
    ram = float(o.get("gpu_ram") or 0)
    ram_gb = ram / 1024 if ram >= 256 else ram
    fields = (
        str(o.get("id")),
        str(o.get("gpu_name") or ""),
        f"{dph:.4f}",
        loc.replace("\t", " "),
        f"{float(rel):.3f}",
        f"{float(o.get("inet_down") or 0):.0f}",
        f"{ram_gb:.0f}",
        f"{float(o.get("storage_cost") or 0):.4f}",
    )
    print("\t".join(fields))
' "$offer_type"
}

parse_new_contract() {
  python3 -c '
import json, sys
text = sys.stdin.read()
obj = None
raw = text.strip()
if raw:
    try:
        obj = json.loads(raw)
    except json.JSONDecodeError:
        i = -1
        for ch in "{[":
            j = text.find(ch)
            if j >= 0 and (i < 0 or j < i):
                i = j
        if i >= 0:
            try:
                obj, _ = json.JSONDecoder().raw_decode(text[i:])
            except json.JSONDecodeError:
                obj = None
if isinstance(obj, dict) and obj.get("success") and obj.get("new_contract") not in (None, ""):
    print(obj["new_contract"])
    raise SystemExit(0)
msg = ""
code = None
if isinstance(obj, dict):
    msg = str(obj.get("msg") or "")
    code = obj.get("status_code")
    err = obj.get("error")
    print(msg or (err if isinstance(err, str) else raw) or "create failed", file=sys.stderr)
elif raw:
    print(raw, file=sys.stderr)
retry = code == 410 or "no_such_ask" in msg.lower()
raise SystemExit(3 if retry else 4)
'
}

print_offer_card() {
  local idx=$1 total=$2 size=$3 offer_type=$4 price_kind=$5
  local offer_id=$6 gpu_name=$7 create_bid=$8 loc=$9 rel=${10} down=${11} ram=${12} sc=${13} disk=${14} max_disk_day=${15}
  local gpu_day disk_day total_day
  gpu_day=$(python3 -c "print('{:.2f}'.format(float('$create_bid') * 24))")
  disk_day=$(python3 -c "print('{:.2f}'.format(float('$sc') * float('$disk') / 30))")
  total_day=$(python3 -c "print('{:.2f}'.format(float('$create_bid') * 24 + float('$sc') * float('$disk') / 30))")
  cat <<EOF
kva: offer ${idx}/${total}  (size=$size type=$offer_type)
  gpu:     $gpu_name  (${ram} GB)
  offer:   $offer_id
  price:   \$$create_bid / hour  ($price_kind)
  day:     \$$total_day / 24h  (GPU \$$gpu_day + disk \$$disk_day)
  loc:     $loc
  rel:     $rel
  down:    ${down} Mbps
  disk:    ${disk} GB  (\$${sc}/GB/month, cap \$${max_disk_day}/day)
EOF
}

next_bid_price() {
  local current=$1 bump=${2:-0.20} explicit=${3:-} cap=${4:-}
  python3 -c "
c = float('$current' or 0)
explicit = '$explicit'
bump = float('$bump' or 0)
cap = '$cap'
if explicit:
    p = float(explicit)
elif bump <= 0:
    p = c
else:
    p = max(c * (1 + bump), c + 0.01, 0.01)
if cap:
    p = min(p, float(cap))
if p < 0:
    p = 0
print('{:.4f}'.format(p))
"
}

read_instance_info() {
  local raw
  raw=$(vastai show instance "$1" --raw --full --no-color) \
    || die "vastai show instance failed for $1"
  printf '%s\n' "$raw" | python3 -c '
import json, sys
data = json.load(sys.stdin)
inst = data.get("instances", data)
if isinstance(inst, list):
    inst = inst[0] if inst else {}
status = str(inst.get("actual_status") or inst.get("cur_state") or "")
dph = inst.get("dph_total")
if dph is None:
    dph = inst.get("min_bid") or inst.get("dph_base") or 0
is_bid = inst.get("is_bid")
if is_bid is True:
    is_bid_s = "1"
elif is_bid is False:
    is_bid_s = "0"
else:
    is_bid_s = ""
gpu = str(inst.get("gpu_name") or "").replace("\t", " ")
print("\t".join([status, f"{float(dph):.4f}", is_bid_s, gpu]))
'
}

confirm_yes() {
  local yes=$1
  local prompt=$2
  if [[ "$yes" -eq 1 ]]; then
    printf 'kva: --yes set; proceeding without prompt\n' >&2
    return 0
  fi
  if [[ ! -t 0 ]]; then
    die "refusing to proceed without a TTY; re-run with --yes"
  fi
  printf '%s [y/N] ' "$prompt"
  local ans
  read -r ans
  case "$ans" in
    y|Y|yes|YES) return 0 ;;
    *) die "cancelled" ;;
  esac
}

# 0 = rent this offer, 1 = next offer, 2 = quit
confirm_offer() {
  local yes=$1 idx=$2 total=$3
  local prompt="Create this instance? [y]es / [n]ext / [q]uit"
  if [[ "$yes" -eq 1 ]]; then
    printf 'kva: --yes set; taking offer %s/%s\n' "$idx" "$total" >&2
    return 0
  fi
  local ans
  if [[ -t 0 ]]; then
    printf '%s ' "$prompt"
    read -r ans || return 2
  else
    read -r ans || die "refusing to proceed without a TTY; re-run with --yes"
  fi
  case "$ans" in
    y|Y|yes|YES) return 0 ;;
    q|Q|quit|QUIT) return 2 ;;
    n|N|no|NO|"") return 1 ;;
    *)
      printf 'kva: unknown answer %s (use y, n, or q)\n' "$ans" >&2
      return 1
      ;;
  esac
}

wait_instance_running() {
  local id=$1
  local i status
  for i in $(seq 1 40); do
    status=$(vastai show instance "$id" --raw --full --no-color | python3 -c '
import json, sys
data = json.load(sys.stdin)
inst = data.get("instances", data)
if isinstance(inst, list):
    inst = inst[0] if inst else {}
print(inst.get("actual_status") or "")
')
    printf 'kva: instance %s status=%s\n' "$id" "${status:-unknown}"
    case "$status" in
      running) return 0 ;;
      exited|unknown|offline)
        die "instance $id entered $status; destroy it and try kva new again"
        ;;
    esac
    sleep 15
  done
  die "timed out waiting for instance $id to become running"
}

kva_new() {
  local size="small" gpu="" max_dph="" disk="20" max_disk_day="2" label="odyssey" inet_down="500" yes=0 dry=0
  local spot=1 bid_price="" bid_pct="10" bid_pct_set=0 min_ram="" filter_desc max_storage
  local offer_type create_bid price_kind bid_frac kind
  while [[ $# -gt 0 ]]; do
    case $1 in
      --size)
        [[ $# -ge 2 ]] || die "--size requires small, medium, or large"
        size=$(printf '%s' "$2" | tr '[:upper:]' '[:lower:]')
        shift 2
        ;;
      --gpu)
        [[ $# -ge 2 ]] || die "--gpu requires a name"
        gpu=$2
        shift 2
        ;;
      --max-dph)
        [[ $# -ge 2 ]] || die "--max-dph requires a USD value"
        max_dph=$2
        shift 2
        ;;
      --disk)
        [[ $# -ge 2 ]] || die "--disk requires GB"
        disk=$2
        shift 2
        ;;
      --max-disk-day)
        [[ $# -ge 2 ]] || die "--max-disk-day requires a USD value"
        max_disk_day=$2
        shift 2
        ;;
      --label)
        [[ $# -ge 2 ]] || die "--label requires a name"
        label=$2
        shift 2
        ;;
      --inet-down)
        [[ $# -ge 2 ]] || die "--inet-down requires Mbps"
        inet_down=$2
        shift 2
        ;;
      --spot) spot=1; shift ;;
      --on-demand) spot=0; shift ;;
      --bid-pct|--bid-price-pct)
        [[ $# -ge 2 ]] || die "--bid-pct requires a percent (e.g. 10)"
        bid_pct=$2
        bid_pct_set=1
        spot=1
        shift 2
        ;;
      --bid-price)
        [[ $# -ge 2 ]] || die "--bid-price requires a USD value"
        bid_price=$2
        spot=1
        shift 2
        ;;
      --yes|-y) yes=1; shift ;;
      --dry-run) dry=1; shift ;;
      -h|--help) usage; exit 0 ;;
      *) die "unknown option: $1 (see kva new --help)" ;;
    esac
  done

  if [[ "$spot" -eq 0 && ( -n "$bid_price" || "$bid_pct_set" -eq 1 ) ]]; then
    die "--bid-pct / --bid-price require a spot instance (omit --on-demand)"
  fi
  python3 -c "
p = float('$bid_pct')
if p < 0:
    raise SystemExit(1)
" || die "--bid-pct must be a number >= 0"
  bid_frac=$(python3 -c "print('{:.6f}'.format(float('$bid_pct') / 100.0))")

  case "$size" in
    small)
      [[ -n "$gpu" ]] || gpu="RTX_3060"
      [[ -n "$max_dph" ]] || max_dph="0.1"
      ;;
    medium)
      [[ -n "$gpu" ]] || min_ram="20"
      [[ -n "$max_dph" ]] || max_dph="0.5"
      ;;
    large)
      [[ -n "$gpu" ]] || min_ram="40"
      [[ -n "$max_dph" ]] || max_dph="2.5"
      ;;
    *) die "unknown --size: $size (use small, medium, or large)" ;;
  esac

  if [[ -n "$gpu" ]]; then
    filter_desc=$gpu
  else
    filter_desc="size=$size (gpu_ram>=${min_ram})"
  fi

  max_storage=$(storage_cost_cap "$max_disk_day" "$disk")
  if [[ "$spot" -eq 1 ]]; then
    offer_type=bid
    price_kind="spot bid"
  else
    offer_type=on-demand
    price_kind="on-demand"
  fi

  if [[ "$dry" -eq 1 ]]; then
    printf 'kva: size=%s max-dph=%s disk=%s max-disk-day=%s type=%s bid-pct=%s query=%s\n' \
      "$size" "$max_dph" "$disk" "$max_disk_day" "$offer_type" "$bid_pct" \
      "$(build_offer_query "$gpu" "$max_dph" "$inet_down" "$min_ram" "$disk" "$max_storage")"
    return 0
  fi

  require_cmd vastai
  require_identity

  local row offer_id gpu_name dph loc rel down ram sc
  local -a rows=()
  set +e
  row=$(search_offers "$gpu" "$max_dph" "$inet_down" "$min_ram" "$disk" "$max_storage" "$offer_type")
  local pick_rc=$?
  set -e
  [[ "$pick_rc" -eq 0 && -n "$row" ]] || die "no matching $filter_desc offers under \$$max_dph/hr with disk <\$${max_disk_day}/day; try --size, --gpu, --max-dph, or --max-disk-day"
  while IFS= read -r line; do
    [[ -n "$line" ]] && rows+=("$line")
  done <<<"$row"
  local total=${#rows[@]}
  [[ "$total" -gt 0 ]] || die "no matching $filter_desc offers under \$$max_dph/hr with disk <\$${max_disk_day}/day; try --size, --gpu, --max-dph, or --max-disk-day"
  printf 'kva: %s matching offer(s); y=rent  n=next  q=quit\n' "$total"

  if [[ "$spot" -eq 1 ]]; then
    cat <<EOF

WARNING: creating starts GPU + disk billing immediately.
This is an interruptible (spot) instance — it can stop if outbid.
Resume with a higher bid:  kva resume
Destroy when done:         kva stop
EOF
  else
    cat <<EOF

WARNING: creating starts GPU + disk billing immediately.
Destroy when done:  kva stop
EOF
  fi

  local i idx choice create_raw parse_rc inst_id="" selected_bid=""
  for i in "${!rows[@]}"; do
    IFS=$'\t' read -r offer_id gpu_name dph loc rel down ram sc <<<"${rows[$i]}"
    idx=$((i + 1))
    create_bid=$dph
    kind=$price_kind
    if [[ "$spot" -eq 1 ]]; then
      create_bid=$(next_bid_price "$dph" "$bid_frac" "$bid_price" "$max_dph")
      if [[ -n "$bid_price" || "$bid_pct" == "0" ]]; then
        kind="spot bid"
      else
        kind="spot bid, min \$${dph} +${bid_pct}%"
      fi
    fi
    print_offer_card "$idx" "$total" "$size" "$offer_type" "$kind" \
      "$offer_id" "$gpu_name" "$create_bid" "$loc" "$rel" "$down" "$ram" "$sc" "$disk" "$max_disk_day"

    set +e
    confirm_offer "$yes" "$idx" "$total"
    choice=$?
    set -e
    case "$choice" in
      0) ;;
      1)
        printf 'kva: skipping offer %s\n' "$offer_id"
        continue
        ;;
      *) die "cancelled" ;;
    esac

    local -a create_args=(
      create instance "$offer_id"
      --image vastai/pytorch:@vastai-automatic-tag
      --disk "$disk" --ssh --direct --label "$label"
      --cancel-unavail --raw --full --no-color
    )
    if [[ "$spot" -eq 1 ]]; then
      create_args+=(--bid_price "$create_bid")
    fi
    set +e
    create_raw=$(vastai "${create_args[@]}" 2>&1)
    set -e
    set +e
    inst_id=$(printf '%s\n' "$create_raw" | parse_new_contract)
    parse_rc=$?
    set -e
    if [[ "$parse_rc" -eq 0 && -n "$inst_id" ]]; then
      selected_bid=$create_bid
      break
    fi
    if [[ "$parse_rc" -eq 3 ]]; then
      printf 'kva: offer %s is no longer available; trying next\n' "$offer_id"
      inst_id=""
      continue
    fi
    die "vastai create instance failed${create_raw:+: ${create_raw}}"
  done
  [[ -n "$inst_id" ]] || die "no offer selected (or all were taken); retry kva new"
  printf 'kva: created instance %s  (~$%s/hr %s)\n' "$inst_id" "$selected_bid" "$price_kind"
  write_context "$inst_id"
  wait_instance_running "$inst_id"
  printf 'kva: ready  current-context=%s\n' "$inst_id"
  printf '  kva exec -f notebooks/colab_odyssey.py\n'
  if [[ "$spot" -eq 1 ]]; then
    printf '  kva resume\n'
  fi
  printf '  kva stop\n'
}

kva_exec() {
  INSTANCE_ID=${VAST_INSTANCE_ID:-}
  local script_file="" setup=0 nosync=0
  DETACH=0
  EXTRA_ARGS=()

  while [[ $# -gt 0 ]]; do
    case $1 in
      -s|--session)
        [[ $# -ge 2 ]] || die "-s requires an instance id"
        INSTANCE_ID=$2
        shift 2
        ;;
      -f|--file)
        [[ $# -ge 2 ]] || die "-f requires a script path"
        script_file=$2
        shift 2
        ;;
      --setup) setup=1; shift ;;
      --detach) DETACH=1; shift ;;
      --no-sync) nosync=1; shift ;;
      -h|--help) usage; exit 0 ;;
      --) shift; EXTRA_ARGS=("$@"); break ;;
      *) die "unknown option: $1 (see kva exec --help)" ;;
    esac
  done

  require_instance
  [[ -n "$script_file" ]] || die "missing -f SCRIPT.py"
  resolve_script "$script_file"
  parse_ssh_url

  local stamp stem
  stamp=$(date +%Y%m%d-%H%M%S)
  stem=$(basename "$REL_SCRIPT" .py)
  LOG_NAME="${stamp}_${stem}.log"
  LOCAL_LOG_DIR="$REPO_ROOT/runs/kva"
  LOCAL_LOG="$LOCAL_LOG_DIR/$LOG_NAME"
  REMOTE_LOG="$REMOTE_DIR/runs/kva/$LOG_NAME"
  mkdir -p "$LOCAL_LOG_DIR"

  if [[ "$nosync" -eq 0 ]]; then
    kva_log "ssh -i $SSH_IDENTITY -p $SSH_PORT $SSH_USERHOST"
    kva_log "syncing $REPO_ROOT -> $SSH_USERHOST:$REMOTE_DIR"
    sync_repo
  fi
  if [[ "$EXT_SCRIPT" -eq 1 ]]; then
    upload_script
  fi
  remote_ssh "mkdir -p $(quote_remote "$REMOTE_DIR/runs/kva")"
  if [[ "$setup" -eq 1 ]]; then
    kva_log "pip install -e . on $SSH_USERHOST"
    run_setup
  fi

  log_header >"$LOCAL_LOG"
  if kva_verbose; then
    cat "$LOCAL_LOG"
  fi
  remote_ssh "cat >> $(quote_remote "$REMOTE_LOG")" <"$LOCAL_LOG"

  local qdir py
  qdir=$(quote_remote "$REMOTE_DIR")
  py=$(remote_python_cmd)

  if [[ "$DETACH" -eq 1 ]]; then
    local qlog pid
    qlog=$(quote_remote "$REMOTE_LOG")
    pid=$(remote_ssh "set -euo pipefail; cd $qdir; export PYTHONPATH=src PYTHONUNBUFFERED=1; nohup $py >> $qlog 2>&1 < /dev/null & echo \$!" | tail -n 1)
    {
      echo "detached pid: $pid"
      echo "remote log: $REMOTE_LOG"
      echo "local log: $LOCAL_LOG"
    } | tee -a "$LOCAL_LOG"
    return 0
  fi

  kva_log "running $REL_SCRIPT on $SSH_USERHOST (log $LOCAL_LOG)"
  set +e
  remote_ssh "set -euo pipefail; cd $qdir; export PYTHONPATH=src PYTHONUNBUFFERED=1; { $py; } 2>&1 | tee -a $(quote_remote "$REMOTE_LOG")" 2>&1 | tee -a "$LOCAL_LOG"
  local rc=${PIPESTATUS[0]}
  set -e
  printf '\nkva: exit %s  log %s\n' "$rc" "$LOCAL_LOG" | tee -a "$LOCAL_LOG"
  return "$rc"
}

kva_sessions() {
  while [[ $# -gt 0 ]]; do
    case $1 in
      -h|--help) usage; exit 0 ;;
      *) die "unknown option: $1 (see kva sessions --help)" ;;
    esac
  done
  require_cmd vastai
  local raw
  raw=$(vastai show instances --raw --full --no-color) \
    || die "vastai show instances failed"
  printf '%s\n' "$raw" | KVA_CURRENT_CONTEXT="$(read_context)" python3 -c '
import json, os, sys

def as_list(data):
    if isinstance(data, list):
        return data
    if isinstance(data, dict):
        insts = data.get("instances") or data.get("results") or data.get("data")
        if isinstance(insts, list):
            return insts
        if isinstance(insts, dict):
            return list(insts.values())
        if "id" in data:
            return [data]
    return []

data = json.load(sys.stdin)
insts = as_list(data)
cur = os.environ.get("KVA_CURRENT_CONTEXT") or ""
rows = []
for inst in insts:
    if not isinstance(inst, dict):
        continue
    iid = str(inst.get("id") or "")
    mark = "*" if iid == cur else ""
    status = str(inst.get("actual_status") or inst.get("cur_state") or inst.get("status") or "")
    gpu = str(inst.get("gpu_name") or "")
    dph = inst.get("dph_total")
    if dph is None:
        dph = inst.get("dph_base") or 0
    try:
        dph_s = f"{float(dph):.4f}"
    except (TypeError, ValueError):
        dph_s = str(dph)
    disk = inst.get("disk_space")
    try:
        disk_s = f"{float(disk):.0f}" if disk not in (None, "") else ""
    except (TypeError, ValueError):
        disk_s = str(disk or "")
    label = str(inst.get("label") or "")
    loc = str(inst.get("geolocation") or "").replace("\t", " ")
    rows.append((mark, iid, status, gpu, dph_s, disk_s, label, loc))

if not rows:
    print("kva: no instances")
    raise SystemExit(0)

print(f"kva: {len(rows)} instance(s)")
hdr = ("", "ID", "STATUS", "GPU", "$/HR", "DISK", "LABEL", "LOC")
widths = [max(len(h), max(len(r[i]) for r in rows)) for i, h in enumerate(hdr)]
fmt = "  ".join(f"{{:<{w}}}" for w in widths)
print(fmt.format(*hdr))
for r in rows:
    print(fmt.format(*r))
'
}

kva_resume() {
  INSTANCE_ID=${VAST_INSTANCE_ID:-}
  local yes=0 dry=0 bid_price="" bid_pct="20" bid_pct_set=0
  while [[ $# -gt 0 ]]; do
    case $1 in
      -s|--session)
        [[ $# -ge 2 ]] || die "-s requires an instance id"
        INSTANCE_ID=$2
        shift 2
        ;;
      --bid-pct|--bid-price-pct)
        [[ $# -ge 2 ]] || die "--bid-pct requires a percent (e.g. 20)"
        bid_pct=$2
        bid_pct_set=1
        shift 2
        ;;
      --bid-price)
        [[ $# -ge 2 ]] || die "--bid-price requires a USD value"
        bid_price=$2
        shift 2
        ;;
      --yes|-y) yes=1; shift ;;
      --dry-run) dry=1; shift ;;
      -h|--help) usage; exit 0 ;;
      *) die "unknown option: $1 (see kva resume --help)" ;;
    esac
  done
  require_instance
  require_cmd vastai
  python3 -c "
p = float('$bid_pct')
if p < 0:
    raise SystemExit(1)
" || die "--bid-pct must be a number >= 0"
  local bid_frac
  bid_frac=$(python3 -c "print('{:.6f}'.format(float('$bid_pct') / 100.0))")

  local status current_bid is_bid gpu_name new_bid
  IFS=$'\t' read -r status current_bid is_bid gpu_name <<<"$(read_instance_info "$INSTANCE_ID")"
  new_bid=$(next_bid_price "$current_bid" "$bid_frac" "$bid_price")

  if [[ "$status" == "running" && -z "$bid_price" && "$bid_pct_set" -eq 0 ]]; then
    printf 'kva: instance %s is already running ($%s/hr)\n' "$INSTANCE_ID" "$current_bid"
    return 0
  fi

  cat <<EOF
kva: resume instance $INSTANCE_ID  (status=${status:-unknown}  gpu=${gpu_name:-?})
  current bid: \$$current_bid / hour
  new bid:     \$$new_bid / hour
EOF
  if [[ "$status" == "running" ]]; then
    printf 'kva: instance is running; will raise bid only\n'
  else
    printf 'WARNING: a higher bid increases GPU cost if the instance starts.\n'
  fi

  if [[ "$dry" -eq 1 ]]; then
    printf 'kva: vastai change bid %s --price %s\n' "$INSTANCE_ID" "$new_bid"
    if [[ "$status" != "running" ]]; then
      printf 'kva: vastai start instance %s\n' "$INSTANCE_ID"
    fi
    return 0
  fi

  if [[ "$status" == "running" ]]; then
    confirm_yes "$yes" "Raise bid to \$$new_bid/hr?"
  else
    confirm_yes "$yes" "Raise bid to \$$new_bid/hr and start?"
  fi

  set +e
  vastai change bid "$INSTANCE_ID" --price "$new_bid" --raw --full --no-color
  local bid_rc=$?
  set -e
  if [[ "$bid_rc" -ne 0 ]]; then
    if [[ -n "$bid_price" || "$is_bid" == "1" ]]; then
      die "vastai change bid failed for $INSTANCE_ID"
    fi
    printf 'kva: change bid failed (on-demand instance?); starting without a new bid\n' >&2
  else
    printf 'kva: bid %s -> $%s/hr\n' "$INSTANCE_ID" "$new_bid"
  fi

  if [[ "$status" == "running" ]]; then
    return 0
  fi
  vastai start instance "$INSTANCE_ID" --raw --full --no-color \
    || die "vastai start instance failed for $INSTANCE_ID"
  printf 'kva: starting instance %s\n' "$INSTANCE_ID"
  wait_instance_running "$INSTANCE_ID"
  printf 'kva: ready  current-context=%s  ~$%s/hr\n' "$INSTANCE_ID" "$new_bid"
}

kva_stop() {
  INSTANCE_ID=${VAST_INSTANCE_ID:-}
  local yes=0
  while [[ $# -gt 0 ]]; do
    case $1 in
      -s|--session)
        [[ $# -ge 2 ]] || die "-s requires an instance id"
        INSTANCE_ID=$2
        shift 2
        ;;
      --yes|-y) yes=1; shift ;;
      -h|--help) usage; exit 0 ;;
      *) die "unknown option: $1 (see kva stop --help)" ;;
    esac
  done
  require_instance
  require_cmd vastai
  printf 'kva: destroy instance %s (GPU + disk billing stop)\n' "$INSTANCE_ID" >&2
  printf 'WARNING: this cannot be undone; files on the instance are deleted.\n' >&2
  confirm_yes "$yes" "Destroy this instance?"
  vastai destroy instance "$INSTANCE_ID" -y \
    || die "vastai destroy instance failed for $INSTANCE_ID"
  printf 'kva: destroyed instance %s\n' "$INSTANCE_ID"
  if [[ "$(read_context)" == "$INSTANCE_ID" ]]; then
    clear_context
    printf 'kva: current-context cleared\n'
  fi
}

kva_ssh() {
  INSTANCE_ID=${VAST_INSTANCE_ID:-}
  local port=8080 forward="" dry=0
  local -a extra=()
  while [[ $# -gt 0 ]]; do
    case $1 in
      -s|--session)
        [[ $# -ge 2 ]] || die "-s requires an instance id"
        INSTANCE_ID=$2
        shift 2
        ;;
      --port)
        [[ $# -ge 2 ]] || die "--port requires a port number"
        port=$2
        shift 2
        ;;
      -L)
        [[ $# -ge 2 ]] || die "-L requires a forward spec"
        forward=$2
        shift 2
        ;;
      --dry-run) dry=1; shift ;;
      -h|--help) usage; exit 0 ;;
      --) shift; extra=("$@"); break ;;
      *) die "unknown option: $1 (see kva ssh --help)" ;;
    esac
  done
  require_instance
  if [[ -z "$forward" ]]; then
    forward="${port}:localhost:${port}"
  fi
  parse_ssh_url
  local orig_term=${TERM:-} remote_term
  remote_term=$(ssh_term)
  export TERM="$remote_term"
  local -a cmd=(
    ssh
    -o StrictHostKeyChecking=accept-new
    -o IdentitiesOnly=yes
    -i "$SSH_IDENTITY"
    -p "$SSH_PORT"
    -L "$forward"
  )
  if [[ ${#extra[@]} -eq 0 ]]; then
    cmd+=(-t)
  fi
  cmd+=("$SSH_USERHOST")
  if [[ ${#extra[@]} -gt 0 ]]; then
    cmd+=("${extra[@]}")
  fi
  printf 'kva: forward http://127.0.0.1:%s  (-L %s)\n' "${forward%%:*}" "$forward"
  if [[ "$orig_term" != "$remote_term" ]]; then
    printf 'kva: TERM=%s (remote has no %s terminfo)\n' "$remote_term" "${orig_term:-unset}"
  fi
  printf 'kva:'
  local a
  for a in "${cmd[@]}"; do
    printf ' %q' "$a"
  done
  printf '\n'
  if [[ "$dry" -eq 1 ]]; then
    return 0
  fi
  exec "${cmd[@]}"
}

kva_use_context() {
  local unset=0 id=""
  while [[ $# -gt 0 ]]; do
    case $1 in
      --unset) unset=1; shift ;;
      -h|--help) usage; exit 0 ;;
      -*) die "unknown option: $1 (see kva use-context --help)" ;;
      *)
        [[ -z "$id" ]] || die "too many arguments (see kva use-context --help)"
        id=$1
        shift
        ;;
    esac
  done
  if [[ "$unset" -eq 1 ]]; then
    clear_context
    printf 'kva: current-context cleared\n'
    return 0
  fi
  [[ -n "$id" ]] || die "use-context requires an instance id"
  write_context "$id"
  printf 'Switched to context "%s".\n' "$id"
}

kva_current_context() {
  while [[ $# -gt 0 ]]; do
    case $1 in
      -h|--help) usage; exit 0 ;;
      *) die "unknown option: $1 (see kva current-context --help)" ;;
    esac
  done
  local id
  id=$(read_context)
  [[ -n "$id" ]] || die "error: current-context is not set"
  printf '%s\n' "$id"
}

cmd=${1:-}
if [[ $# -gt 0 ]]; then
  shift
fi
case $cmd in
  new|up) kva_new "$@" ;;
  exec) kva_exec "$@" ;;
  sessions) kva_sessions "$@" ;;
  upload) kva_upload "$@" ;;
  download) kva_download "$@" ;;
  ssh) kva_ssh "$@" ;;
  use-context|use) kva_use_context "$@" ;;
  current-context|context) kva_current_context "$@" ;;
  resume|start) kva_resume "$@" ;;
  stop|destroy) kva_stop "$@" ;;
  -h|--help|help|"") usage; exit 0 ;;
  *)
    printf 'kva: unknown command: %s\n\n' "$cmd" >&2
    usage >&2
    exit 2
    ;;
esac
